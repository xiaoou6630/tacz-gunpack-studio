{
  "gun_id": "ksg",
  "parts": [
    {
      "name": "Receiver / action housing",
      "bone": "receiver",
      "description": "黑色低饱和蓝灰聚合物机匣，Z≈-2.0..+6.25、Y≈5.5..9.9、X≈±1.625；bullpup 布局，核心/下机匣/顶盖/侧板/前后斜面/螺钉分层，组合口在下方 Z≈6.0..7.0。",
      "cubes": []
    },
    {
      "name": "Barrel",
      "bone": "barrel",
      "description": "固定枪管，轴线 Y=8.2，Z≈-18.75..-1.75；八边形截面由 8 条长条 + 中心芯组成，外径约 1.15；前后各有一圈 8 片加强环，枪口 -Z，无制退器。",
      "cubes": []
    },
    {
      "name": "Dual magazine tubes",
      "bone": "mag_tubes",
      "description": "两根并列八边形管式弹仓，中心 X=±0.6875、Y≈6.6、Z≈-18.5..+6.75；每根由 8 条长条 + 芯 + 8 片前环组成，固定不随 pump 移动；后端接组合口内 loading_port。",
      "cubes": []
    },
    {
      "name": "Pump / forend",
      "bone": "pump",
      "description": "低饱和蓝灰聚合物滑动护木，Z≈-14.75..-6.25、Y≈5.1..9.1、X≈±1.8125；上下/左右/前后端盖与四角倒角，侧面 4 条 M-LOK 槽，底部 pump_rail 为 0.75 宽 1-5-1 短轨；泵动行程由 data-smith 按新尺度补。",
      "cubes": []
    },
    {
      "name": "Top Picatinny rail",
      "bone": "top_rail",
      "description": "顶部皮卡汀尼导轨，底宽 0.75、Z≈-16.75..+3.5、Y≈10.25..10.75；1-5-1 齿型（0.25 单位，1 空-5 齿-1 空），下带 0.6 宽支撑脊与前后支撑；前/后 flip-up 瞄具装在齿顶。",
      "cubes": []
    },
    {
      "name": "Stock",
      "bone": "stock",
      "description": "bullpup 枪托壳体，Z≈+5.75..+12.5、Y≈5.0..10.0、X≈±1.625；实心芯 + 上下侧板 + 贴腮 + 前箍 + 后桥，侧面三角形减重凹槽和接缝；后端接橡胶托底。",
      "cubes": []
    },
    {
      "name": "Pistol grip",
      "bone": "pistol_grip",
      "description": "近垂直握把，Z≈3.9..6.2、Y≈3.25..6.5、X≈±1.06；上/中/下三段 + 前后带 + 侧板 + 三道防滑肋，底部 Y≈3.25 决定总高。",
      "cubes": []
    },
    {
      "name": "Trigger",
      "bone": "trigger",
      "description": "护圈内扳机片，pivot=(0,5.3,4.85)，Z≈4.75..5.0、Y≈4.4..5.3；含扳机片、鞋、pin，开火时 data-smith 转 -8°。",
      "cubes": []
    },
    {
      "name": "Trigger guard",
      "bone": "trigger_guard",
      "description": "低饱和聚合物护圈，Z≈3.25..6.0、Y≈4.25..5.4、X≈±0.6；前/下/后三段 + 侧唇，开口足够容纳扳机片。",
      "cubes": []
    },
    {
      "name": "Cross-bolt safety",
      "bone": "safety",
      "description": "横推式保险，pivot=(0,6.0,5.65)，Z≈5.5..5.8；钢制横栓 + 白/红两端帽，左右各露约 0.25。",
      "cubes": []
    },
    {
      "name": "Magazine tube selector",
      "bone": "tube_selector",
      "description": "三位置弹仓选择杆，pivot=(0,5.6,7.0)，位于双管尾端、握把后方下方；轴 + 拨片 + 拇指片，可从下方和侧方看到，动画只做视觉旋转。",
      "cubes": []
    },
    {
      "name": "Combined ejection port",
      "bone": "ejection_port",
      "description": "单一向下组合口，Z≈6.0..7.0、Y≈4.9..5.5、X≈±1.25；前/后/侧唇 + 深色内壁，无侧面抛壳口；shell locator 在内侧。",
      "cubes": []
    },
    {
      "name": "Left tube loading mouth",
      "bone": "loading_port_L",
      "description": "左管在组合口内的装填入口，pivot=(-0.6875,5.5,6.875)；内部短口，不是第二个外部洞；子骨 loading_gate_L 可做装填动画。",
      "cubes": []
    },
    {
      "name": "Right tube loading mouth",
      "bone": "loading_port_R",
      "description": "右管在组合口内的装填入口，pivot=(0.6875,5.5,6.875)；与左口对称，间距 1.375。",
      "cubes": []
    },
    {
      "name": "Rubber buttpad",
      "bone": "buttpad",
      "description": "橡胶托底，Z≈11.75..12.5、Y≈5.0..9.75、X≈±1.625；主垫 + 上下亮边，轮廓略大于枪托尾端。",
      "cubes": []
    },
    {
      "name": "Sling loop / slot",
      "bone": "sling_loop",
      "description": "枪托后下方背带环，pivot=(0,5.3,10.8)；两立柱 + 底杆的小 U 形，尺寸约 1.3×1.0×0.8。",
      "cubes": []
    },
    {
      "name": "Muzzle",
      "bone": "muzzle",
      "description": "枪口八边形端环，Z≈-19.25..-18.75、Y=8.2、X≈±0.55；8 片钢环 + 深色膛口芯，muzzle_pos/muzzle_flash 在 positioning2 下。",
      "cubes": []
    },
    {
      "name": "Front sight",
      "bone": "front_sight",
      "description": "导轨前端 flip-up 准星，pivot=(0,10.75,-15.625)；底座 Z≈-16.0..-15.5，柱顶 Y≈11.75，两侧护耳。",
      "cubes": []
    },
    {
      "name": "Rear sight",
      "bone": "rear_sight",
      "description": "导轨后端 flip-up 照门，pivot=(0,10.75,2.375)；底座 Z≈2.0..2.75，叶片顶 Y≈11.6，与准星同一高度基准。",
      "cubes": []
    },
    {
      "name": "Ejected shell",
      "bone": "shell",
      "description": "空弹壳抛壳定位点，pivot=(0,5.2,6.9)，位于组合口内侧、枪身下方；只做 locator，不建弹壳几何，速度由 display 控制。",
      "cubes": []
    }
  ],
